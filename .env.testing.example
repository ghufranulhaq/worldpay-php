# Copy to .env.testing (gitignored) to run `composer test:integration` against Worldpay Try.
# Integration tests are skipped when the username/password are empty.
WORLDPAY_TRY_ENTITY=PO4098288921
WORLDPAY_TRY_USERNAME=
WORLDPAY_TRY_PASSWORD=
# Optional: enables the Checkout session test (Dashboard → Developer Tools → Checkout ID).
WORLDPAY_TRY_CHECKOUT_ID=
